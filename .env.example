# SecureAgent: the ONE settings file. setup.sh copies this to .env and fills in the secrets.
# .env is git-ignored. Never commit it.

# ---- Agent (chat) ----
# scripted = no LLM (repeatable demo) | openrouter = a real LLM through OpenRouter
AGENT_PLANNER=scripted
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
LLM_MODEL=openai/gpt-4o-mini
# Lists export_private_key so the "steal the key" attack can be demoed. The Vault refuses it either way.
EXPOSE_ATTACK_DEMO_TOOLS=1

# ---- Agent identity (setup.sh generates the token and puts its SHA-256 in vault_gateway/policy/policy.yaml) ----
AGENT_ID=crypto-agent
AGENT_TOKEN=
VAULT_URL=http://127.0.0.1:8000

# ---- Service wiring (defaults are fine) ----
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROOT_TOKEN=root
# VAULT_TOKEN is written by vault_gateway/vault_setup/setup_dev.py on every start (limited token, cannot export the key)
VAULT_TOKEN=
ETH_RPC_URL=http://127.0.0.1:8545
SUBMITTER_URL=http://127.0.0.1:8100
PHE_URL=http://127.0.0.1:8300
PHE_API_TOKEN=dev-token
